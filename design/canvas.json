  "annotations": [
    { "id": "note-storefront", "page": "page-1", "x": 0,    "y": -150, "w": 640, "text": "STOREFRONT — desktop 1440.\nHome carries both shelves: equipment in graphite + volt, supplements in ember. Listing and product detail follow the same 4-up card grid." },
    { "id": "note-batch",      "page": "page-1", "x": 3120, "y": -150, "w": 640, "text": "The batch / manufactured / best-before block on the product page is the platform's differentiator — supplements are never listed without it." },
    { "id": "note-buyflow",    "page": "page-2", "x": 0,    "y": -150, "w": 700, "text": "BUY FLOW — cart → delivery → payment → confirmation, one step indicator across all screens. The stack discount is applied automatically; there is no coupon step." },
    { "id": "note-admin",      "page": "page-3", "x": 0,    "y": -150, "w": 640, "text": "ADMIN — the two tiles that matter for this business are low-stock SKUs and batches expiring within 90 days. Revenue chart is a single series, so no legend." },
    { "id": "note-mobile",     "page": "page-3", "x": 1560, "y": -150, "w": 640, "text": "MOBILE 390 — full scroll length, not a single viewport. No fake status bar: the real one renders on top. Every tappable element is at least 44px." },
    { "id": "note-system",     "page": "page-4", "x": 0,    "y": -150, "w": 640, "text": "Tokens and components every other artboard is built from. Anton for headings, Instrument Sans for everything else, 3px radius, no drop shadows." }
  ],
